# Database
POSTGRES_USER=smartpos
POSTGRES_PASSWORD=smartpos_dev_password
POSTGRES_DB=smart_pos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartpos:smartpos_dev_password@localhost:5432/smart_pos?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API & Auth
API_PORT=4000
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Chế độ dữ liệu Frontend: "mock" (chạy không cần API/DB) hoặc "real" (gọi Backend thật)
NEXT_PUBLIC_DATA_MODE=real
# NEXT_PUBLIC_SHOW_DATA_SWITCHER=true

# Object Storage (Cloudflare R2 / S3)
S3_ENDPOINT=
S3_BUCKET=smart-pos-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
